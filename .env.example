# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
PUBLIC_POLL_BASE_URL=http://localhost:3000/p

# Browser origins allowed to send credentialed requests, comma-separated.
# Blank in development: Vite proxies /api and /ws, so the browser sees one
# origin and CORS never engages. REQUIRED in production — the process refuses
# to boot without it, because the device-id cookie is SameSite=None there.
#   CLIENT_ORIGIN=https://pollhub-client.onrender.com
CLIENT_ORIGIN=

# --- Database ---------------------------------------------------------------
#DATABASE_URL=postgres://pollhub:pollhub@localhost:5432/pollhub
#DATABASE_URL=https://uyuzmcdyptiepeqqchlv.supabase.co/rest/v1/
DATABASE_URL=postgresql://postgres.uyuzmcdyptiepeqqchlv:bDAB_qD#wkg%7K$@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

SUPABASE_PWD=bDAB_qD#wkg%7K$

# --- Secrets ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=1195b331b9943ba9318988089265456bd165f6bf797e0364b32f187f80e9a96b67e48227ffa3e1cc4b44d5f8535640aa
COOKIE_SECRET=5d3fa7c7bac11bf3bc78ab8cdef860888426d510782ac644a872837463722cc4615694decae151746cedcf3722da4cac
HASH_PEPPER=a662906ea050aa6352bceedb5afe406fd439d1b45c4d55d79424143474414d2ff8aa0c8aead1255eec8531e7f751af62

# --- Admin bootstrap (read by `npm run seed:admin` only) --------------------
# Not part of the validated env schema — the API never reads these at runtime.
# Leave ADMIN_PASSWORD empty to have one generated and printed once.
ADMIN_EMAIL=admin@pollhub.com
ADMIN_PASSWORD=Admin@123!
ADMIN_NAME=Admin

# --- Proxy ------------------------------------------------------------------
# true only when Cloudflare sits in front. Never sets Express `trust proxy` to
# boolean true — see src/config/trust-proxy.js
BEHIND_CLOUDFLARE=false

# --- Google OAuth (optional) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- Brevo (optional; emails log to console when unset) ---------------------
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=PollHub

# --- Cloudinary (optional; uploads disabled when unset) ---------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=pollhub_signed

# --- Cloudflare Turnstile (optional; challenge skipped when unset) ----------
TURNSTILE_SECRET_KEY=

# --- Push (optional) --------------------------------------------------------
EXPO_ACCESS_TOKEN=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the service-account private key with literal \n escapes
FCM_PRIVATE_KEY=

